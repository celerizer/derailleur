<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The libretro cores are third-party dylibs the user supplies, so the
	     bundle's own signature cannot cover them. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Dolphin and the N64 cores JIT their guest code. Required on arm64 even
	     outside the hardened runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
